body{

background:#f5f5f5;
font-family:Arial;

display:flex;
justify-content:center;
align-items:center;

height:100vh;

}

.contenedor{

width:350px;

background:white;

padding:25px;

border-radius:10px;

box-shadow:0 0 15px rgba(0,0,0,.2);

}

input{

width:100%;

padding:10px;

margin-top:10px;

}

button{

margin-top:20px;

width:100%;

padding:10px;

background:#007BFF;

color:white;

border:none;

cursor:pointer;

}
